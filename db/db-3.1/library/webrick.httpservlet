requires=webrick.httpservlet.abstract,webrick.httputils,webrick.httpstatus,webrick.httpservlet.filehandler,webrick.htmlutils,webrick.httpservlet.cgihandler,webrick.config,webrick.httpversion,webrick.utils,webrick.log,webrick.httpservlet.erbhandler,webrick.httpservlet.prochandler
classes=
