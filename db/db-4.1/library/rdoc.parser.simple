requires=rdoc.parser,rdoc,rdoc.code_objects,rdoc.code_object,rdoc.code_object.context,rdoc.code_object.top_level,rdoc.code_object.class_module,rdoc.code_object.normal_class,rdoc.code_object.normal_module,rdoc.code_object.single_class,rdoc.code_object.any_method,rdoc.code_object.alias,rdoc.code_object.attr,rdoc.code_object.constant,rdoc.code_object.require,rdoc.code_object.include,rdoc.stats,rdoc.parser.simple,rdoc.parser.c,rdoc.parser.ruby,e2mmap,irb.slex,rdoc.token_stream,rdoc.known_classes,rdoc.parser.changelog,time,rdoc.parser.markdown,rdoc.parser.rd
classes=RDoc=Parser=Simple
