source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.Phg2K5/src/refm/api/src/sdbm.rd

--- invert -> Hash

値からキーへのハッシュを返します。

  require 'sdbm'
  
  db1 = SDBM.open('aaa.gdbm', 0666)
  db1.clear
  db1['a'] = 'aaa'
  db1['b'] = 'bbb'
  db1['c'] = 'ccc'
  
  p db1.invert #=> {"aaa"=>"a", "bbb"=>"b", "ccc"=>"c"}

