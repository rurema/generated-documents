source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.Phg2K5/src/refm/api/src/_builtin/Hash

--- to_h -> self | Hash

self を返します。[[c:Hash]] クラスのサブクラスから呼び出した場合は
self を [[c:Hash]] オブジェクトに変換します。

//emlist[例][ruby]{
  hash = {}
  p hash.to_h      # => {}
  p hash.to_h == hash # => true

  class MyHash < Hash;end
  my_hash = MyHash.new
  p my_hash.to_h        # => {}
  p my_hash.class       # => MyHash
  p my_hash.to_h.class  # => Hash
//}



