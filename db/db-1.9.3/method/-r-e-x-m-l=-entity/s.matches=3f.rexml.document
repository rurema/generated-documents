source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.ZtgaSH/src/refm/api/src/rexml/entity.rd

--- matches?(string) -> bool
string が実体宣言の文法に従う文字列であれば真を返します。

@param string 判定対象の文字列

==== 例
  require 'rexml/document'
  
  p REXML::Entity.matches?('<!ENTITY s "seal">') # => true
  p REXML::Entity.matches?('<!ENTITY % s "seal">') # => true
  p REXML::Entity.matches?('<!ELEMENT br EMPTY >') # => false


