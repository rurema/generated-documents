source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.ZtgaSH/src/refm/api/src/syck/../yaml/stream.rd

--- documents -> Array

自身のドキュメントを配列で返します。

  require 'yaml'
  
  str1=<<EOT
  --- !ruby/Dog
  name: pochi
  --- 
  :age: 17
  :color: white
  EOT
  
  ys = YAML.load_stream(str1)
  p ys.documents.pop
  #=> {:age=>17, :color=>"white"}
  p ys.documents.pop
  #=> #<YAML::DomainType:0x2b07e24 @type_id="Dog", @domain="ruby.yaml.org,2002", @value={"name"=>"pochi"}>
  p ys.documents.pop
  #=> nil

