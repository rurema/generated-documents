names=undef_system_command
visibility=public
kind=defined
source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.ZtgaSH/src/refm/api/src/shell.rd

--- undef_system_command(command) -> Shell::CommandProcessor

commandを削除します.

@param command 削除するコマンドの文字列を指定します。

動作例：
  Shell.def_system_command("ls")
  # ls を定義
  Shell.undef_system_command("ls")
  # ls を 削除

  sh = Shell.new
  begin
    sh.transact {
      ls("-l").each {|l|
        puts l
      }
    }
  rescue NameError => err
    puts err
  end

