names=tag
visibility=public
kind=defined
source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/psych/Psych__Nodes

--- tag -> String | nil
ノードに付加されたタグを返します。

タグが付加されていない場合は nil を返します。

  ast = Psych.parse(<<EOS)
  ---
  - !!str a
  - b
  EOS
  
  p ast.root.children[0].value  # => "a"
  p ast.root.children[0].tag    # => "tag:yaml.org,2002:str"
  
  p ast.root.children[1].value  # => "b"
  p ast.root.children[1].tag    # => nil

