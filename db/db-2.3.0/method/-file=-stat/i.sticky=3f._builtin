source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/_builtin/File__Stat

--- sticky? -> bool
stickyビットが立っている時に真を返します。

  Dir.glob("/usr/bin/*") {|bd|
    begin
      if File::Stat.new(bd).sticky?
        puts bd
      end
    rescue
    end
  }
  #例
  #...
  #=> /usr/bin/emacs-21.4
  #...

