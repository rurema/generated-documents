source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/_builtin/UncaughtThrowError

--- tag -> object

[[m:Kernel.#throw]] に指定した tag を返します。

//emlist[例:][ruby]{
def do_complicated_things
  throw :uncaught_label
end

begin
  do_complicated_things
rescue UncaughtThrowError => ex
  p ex.tag # => ":uncaught_label"
end
//}

