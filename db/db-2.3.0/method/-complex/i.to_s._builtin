source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/_builtin/Complex

--- to_s -> String

自身を "実部 + 虚部i" 形式の文字列にして返します。

//emlist[例][ruby]{
Complex(2).to_s                       # => "2+0i"
Complex('-8/6').to_s                  # => "-4/3+0i"
Complex('1/2i').to_s                  # => "0+1/2i"
Complex(0, Float::INFINITY).to_s      # => "0+Infinity*i"
Complex(Float::NAN, Float::NAN).to_s  # => "NaN+NaN*i"
//}

