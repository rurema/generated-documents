names=filename,path
visibility=public
kind=defined
source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/_builtin/ARGF

--- filename -> String
--- path -> String

現在開いている処理対象のファイル名を返します。

標準入力に対しては - を返します。
組み込み変数 [[m:$FILENAME]] と同じです。

  $ echo "foo" > foo
  $ echo "bar" > bar
  $ echo "glark" > glark

  $ ruby argf.rb foo bar glark

  ARGF.filename # => "foo"
  ARGF.read(5)  # => "foo\nb"
  ARGF.filename # => "bar"
  ARGF.skip
  ARGF.filename # => "glark"

