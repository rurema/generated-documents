names=receiver
visibility=public
kind=defined
source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.xqkPhh/src/refm/api/src/_builtin/NameError

--- receiver -> object

self が発生した時のレシーバオブジェクトを返します。

例:

  class Sample
    def foo
      return "foo"
    end
  end

  bar = Sample.new
  begin
    bar.bar
  rescue NameError => err
    p err.receiver  # => #<Sample:0x007fd4d89b3110>
    p err.receiver.foo  # => "foo"
  end

