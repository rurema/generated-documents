classes=IO=ConsoleMode
methods=IO/i.noecho.io.console,IO/i.echo=3d.io.console,IO/i.echo=3f.io.console,IO/i.raw.io.console,IO/i.raw=21.io.console,IO/i.getch.io.console,IO/i.winsize.io.console,IO/i.winsize=3d.io.console,IO/i.iflush.io.console,IO/i.oflush.io.console,IO/i.ioflush.io.console,IO/i.cooked.io.console,IO/i.cooked=21.io.console,IO/i.console_mode.io.console,IO/i.beep.io.console,IO/i.goto.io.console,IO/i.goto_column.io.console,IO/i.cursor.io.console,IO/i.cursor_up.io.console,IO/i.cursor_down.io.console,IO/i.cursor_left.io.console,IO/i.cursor_right.io.console,IO/i.erase_line.io.console,IO/i.erase_screen.io.console,IO/i.clear_screen.io.console,IO/i.scroll_forward.io.console,IO/i.scroll_backward.io.console,IO/i.pressed=3f.io.console,IO/i.check_winsize_changed.io.console,IO/i.getpass.io.console,IO/i.ttyname.io.console,IO/s.console.io.console
