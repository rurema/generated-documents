--- $RS                     -> String | nil
--- $INPUT_RECORD_SEPARATOR -> String | nil

[[m:$/]] の別名

  require "English"

  $INPUT_RECORD_SEPARATOR = '|'
  array = []
  while line = DATA.gets
    array << line
  end
  p array #=> ["ugo|", "ego|", "fogo\n"]

  __END__
  ugo|ego|fogo


