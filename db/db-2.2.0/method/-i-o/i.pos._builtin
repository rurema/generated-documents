source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.wG7wMH/src/refm/api/src/_builtin/IO

--- pos    -> Integer
--- tell   -> Integer

ファイルポインタの現在の位置を整数で返します。

@raise IOError 既に close されている場合に発生します。

//emlist[例][ruby]{
IO.write("testfile", "This is line one\n")
File.open("testfile") do |f|
  f.pos    # => 0
  f.gets   # => "This is line one\n"
  f.pos    # => 17
end
//}

