source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.wG7wMH/src/refm/api/src/_builtin/Encoding

--- error_bytes -> String
エラー発生時に捨てられたバイト列を返します。


  ec = Encoding::Converter.new("EUC-JP", "ISO-8859-1")
  begin
    ec.convert("abc\xA1\xFFdef")
  rescue Encoding::InvalidByteSequenceError
    p $!
    #=> #<Encoding::InvalidByteSequenceError: "\xA1" followed by "\xFF" on EUC-JP>
    puts $!.error_bytes.dump          #=> "\xA1"
    puts $!.readagain_bytes.dump      #=> "\xFF"
  end

@see [[m:Encoding::InvalidByteSequenceError#readagain_bytes]]

