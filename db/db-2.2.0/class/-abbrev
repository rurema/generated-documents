=== 例

  require 'abbrev'
  require 'pp'

  pp Abbrev.abbrev(%w[ruby rules]).sort
      # => [["rub", "ruby"],
      #    ["ruby", "ruby"],
      #    ["rul", "rules"],
      #    ["rule", "rules"],
      #    ["rules", "rules"]]
