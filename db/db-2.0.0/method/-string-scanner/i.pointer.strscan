source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.ryNQ5k/src/refm/api/src/strscan.rd

--- pointer -> Fixnum
--- pos -> Fixnum
現在のスキャンポインタのインデックスを返します。

使用例
      s = StringScanner.new('test string')
      s.pos         # => 0
      s.scan(/\w+/) # => "test"
      s.pos         # => 4
      s.scan(/\w+/) # => nil
      s.pos         # => 4
      s.scan(/\s+/) # => " "
      s.pos         # => 5

@see [[m:StringScanner#charpos]]

