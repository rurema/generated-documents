source_location=/tmp/claude-1000/-home-debian-rurema/3717a77b-67d6-4a40-b15e-a41ca141ab34/scratchpad/frozen.ryNQ5k/src/refm/api/src/_builtin/Encoding__Converter

--- replacement=(string)
置換文字を設定します。

@param string 変換器に設定する置換文字

  ec = Encoding::Converter.new("utf-8", "us-ascii", :undef => :replace)
  ec.replacement = "<undef>"
  p ec.convert("a \u3042 b")      #=> "a <undef> b"

